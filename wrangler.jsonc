{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "splash",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-14",
  "build": { "command": "node scripts/build.mjs" },
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "vars": {
    "QUOTE_TO": "angelkhatib4@gmail.com",
    "SITE_ORIGIN": "https://splashanddash.uluxe.site"
  },
  "ratelimits": [{ "name": "QUOTE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
